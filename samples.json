    "apple": ["apple.com", "icloud.com"],
    "microsoft": ["microsoft.com", "live.com", "onedrive.com"],
    "github": ["github.com", "githubusercontent.com"],
    "geolocation-cn": ["baidu.com", "qq.com", "taobao.com"],
