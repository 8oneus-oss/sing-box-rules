     "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-youtube.srs",
     "format": "binary"
    },
    {
     "url": "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/youtube",
